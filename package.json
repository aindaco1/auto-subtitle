{
  "name": "auto-subtitle",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test engine/tests/*.test.mjs tests/development/*.test.mjs",
    "test:quality": "node scripts/check-formatting.mjs",
    "test:apple": "node scripts/check-formatting.mjs --apple",
    "test:jev": "node scripts/check-formatting.mjs --live",
    "test:jev:calibrate": "node scripts/check-formatting.mjs --calibrate --live",
    "start": "node engine/cli.mjs",
    "build:app": "bash scripts/build-app.sh"
  }
}
